# First Job AI — server settings
#
# 1. Copy this file and name the copy ".env" (same folder).
# 2. Fill in the values you need. No quotes, no spaces around "=".
# 3. Restart the app: press Ctrl + C in the terminal, then run "npm run dev".
#
# IMPORTANT: Never rename these to start with VITE_. Variables that start
# with VITE_ are sent to the browser. These ones stay on the server.
# Never commit your real .env file (it is already listed in .gitignore).
# In production, set these in your hosting provider's dashboard instead.

# --- AI (optional) -----------------------------------------------------------
# Anthropic API key from https://console.anthropic.com (starts with sk-ant-).
ANTHROPIC_API_KEY=
# Optional: which model to use. Leave blank for the default (claude-sonnet-5-5).
# Example: claude-opus-5-5 (more capable, costs more per request).
AI_MODEL=

# --- Real job search (JSearch by OpenWeb Ninja) ------------------------------
# Your API key from https://app.openwebninja.com (subscribe to JSearch; the
# free plan works). A key from the JSearch API on https://rapidapi.com also
# works — the app recognizes RapidAPI keys automatically.
JSEARCH_API_KEY=
# Optional: force the provider: openwebninja or rapidapi. Blank = detect from the key.
JSEARCH_PROVIDER=
# Optional: stop searching after this many requests per calendar month
# (set it to your plan's allowance). Blank = no app-side limit.
JSEARCH_MONTHLY_LIMIT=
# Optional: default country for searches (two-letter code, e.g. us, ca, gb).
JSEARCH_COUNTRY=us

# --- Accounts and database ---------------------------------------------------
# Where the SQLite database file lives. On a host, point this at a
# persistent disk (for example /var/data/first-job-ai.db).
DATABASE_PATH=data/first-job-ai.db

# Public address of the site, used in password-reset emails.
# Required in production, e.g. https://firstjob.example.com
APP_URL=

# Password-reset emails are sent with Resend (https://resend.com). Set both
# values, or neither. The key starts with re_.
# Without these, reset links are printed in the terminal during development
# and password reset is turned off in production.
RESEND_API_KEY=
# A sender address on a domain you verified in Resend, e.g. First Job AI <no-reply@yourdomain.com>
EMAIL_FROM=

# --- Production options (usually leave blank) --------------------------------
# PORT=3000
# Set to true when running behind a proxy/load balancer that sets X-Forwarded-For.
# TRUST_PROXY=true
# Cookies are Secure (HTTPS only) in production by default. Only set false
# to test the production build over plain http://localhost.
# COOKIE_SECURE=false
# In production, AI and job search need a signed-in user (protects your paid
# API keys). Set to false to let guests use them too.
# API_REQUIRE_AUTH=false
