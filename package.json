{
  "name": "first-job-ai",
  "private": true,
  "version": "1.0.0",
  "description": "First Job AI helps students, new grads and career changers build a resume, track applications and practice interviews.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --disable-warning=ExperimentalWarning --test && vitest run",
    "stripe:listen": "node --disable-warning=ExperimentalWarning scripts/stripe-listen.mjs",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup-db.mjs",
    "db:import": "node --disable-warning=ExperimentalWarning scripts/import-sqlite.mjs",
    "check:production": "node --disable-warning=ExperimentalWarning scripts/check-production.mjs",
    "check:site": "node scripts/check-site.mjs",
    "account:export": "node --disable-warning=ExperimentalWarning scripts/account-export.mjs",
    "account:import": "node --disable-warning=ExperimentalWarning scripts/account-import.mjs",
    "db:check": "node --disable-warning=ExperimentalWarning scripts/db-check.mjs",
    "reset-link": "node --disable-warning=ExperimentalWarning scripts/reset-link.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  }
}
